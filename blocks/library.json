      { "key": "price1", "selector": ".pkg-row > .pkg-mini:nth-child(1) .pm-price", "kind": "inline", "repeat": false, "optional": false },
      { "key": "detail1", "selector": ".pkg-row > .pkg-mini:nth-child(1) .pm-detail", "kind": "inline", "repeat": false, "optional": false },
      { "key": "link1", "selector": ".pkg-row > .pkg-mini:nth-child(1) a.pm-link", "kind": "link", "repeat": false, "optional": false },
      { "key": "name2", "selector": ".pkg-row > .pkg-mini:nth-child(2) .pm-name", "kind": "text", "repeat": false, "optional": false },
      { "key": "price2", "selector": ".pkg-row > .pkg-mini:nth-child(2) .pm-price", "kind": "inline", "repeat": false, "optional": false },
      { "key": "detail2", "selector": ".pkg-row > .pkg-mini:nth-child(2) .pm-detail", "kind": "inline", "repeat": false, "optional": false },
      { "key": "link2", "selector": ".pkg-row > .pkg-mini:nth-child(2) a.pm-link", "kind": "link", "repeat": false, "optional": false } ] },
