{
  "version": 1,
  "types": {
    "intro": { "label": "Page opening", "families": ["site"], "addable": false, "snippet": "blocks/site/intro.html", "fields": [
      { "key": "label", "selector": ".label", "kind": "text", "repeat": false, "optional": false },
      { "key": "title", "selector": "h1", "kind": "inline", "repeat": false, "optional": false },
      { "key": "lead", "selector": "p.lead", "kind": "inline", "repeat": false, "optional": false } ] },
    "text": { "label": "Text", "families": ["site"], "addable": true, "snippet": "blocks/site/text.html", "fields": [
      { "key": "paragraphs", "selector": "p", "kind": "inline", "repeat": true, "optional": false } ] },
    "heading": { "label": "Heading", "families": ["site"], "addable": true, "snippet": "blocks/site/heading.html", "fields": [
      { "key": "title", "selector": "h2", "kind": "inline", "repeat": false, "optional": false } ] },
    "list": { "label": "List", "families": ["site"], "addable": true, "snippet": "blocks/site/list.html", "fields": [
      { "key": "items", "selector": "ul.list > li", "kind": "inline", "repeat": true, "optional": false } ] },
    "gallery": { "label": "Photo gallery", "families": ["site"], "addable": true, "snippet": "blocks/site/gallery.html", "fields": [
      { "key": "photos", "selector": ".gallery > picture", "kind": "image", "repeat": true, "min": 3, "max": 3, "optional": false } ] },
    "caption": { "label": "Gallery caption", "families": ["site"], "addable": true, "snippet": "blocks/site/caption.html", "fields": [
      { "key": "text", "selector": "p.caption", "kind": "inline", "repeat": false, "optional": false } ] },
    "quote": { "label": "Client quote", "families": ["site"], "addable": true, "snippet": "blocks/site/quote.html", "fields": [
      { "key": "quote", "selector": "blockquote", "kind": "inline", "repeat": false, "optional": false },
      { "key": "credit", "selector": "figcaption", "kind": "text", "repeat": false, "optional": false } ] },
    "price": { "label": "Price box", "families": ["site"], "addable": true, "snippet": "blocks/site/price.html", "fields": [
      { "key": "was", "selector": ".price-box .was s", "kind": "inline", "repeat": false, "optional": true },
      { "key": "amount", "selector": ".price-box .amount", "kind": "inline", "repeat": false, "optional": false },
      { "key": "detail", "selector": ".price-box .detail", "kind": "inline", "repeat": false, "optional": false },
      { "key": "valueNote", "selector": "p.value-note", "kind": "inline", "repeat": false, "optional": true } ] },
    "buttons": { "label": "Buttons", "families": ["site"], "addable": true, "snippet": "blocks/site/buttons.html", "fields": [
      { "key": "primary", "selector": "a.btn:not(.btn-ghost)", "kind": "link", "repeat": false, "optional": false },
      { "key": "secondary", "selector": "a.btn-ghost", "kind": "link", "repeat": false, "optional": true } ] },
    "note": { "label": "Small print", "families": ["site"], "addable": true, "snippet": "blocks/site/note.html", "fields": [
      { "key": "text", "selector": "p.note", "kind": "inline", "repeat": false, "optional": false } ] },
    "portrait": { "label": "Portrait photo", "families": ["site"], "addable": true, "snippet": "blocks/site/portrait.html", "fields": [
      { "key": "photo", "selector": ".portrait > picture", "kind": "image", "repeat": false, "optional": false } ] },
    "signature": { "label": "Signature", "families": ["site"], "addable": true, "snippet": "blocks/site/signature.html", "fields": [
      { "key": "text", "selector": ".sig", "kind": "text", "repeat": false, "optional": false } ] },
    "areas": { "label": "Service areas", "families": ["site"], "addable": true, "snippet": "blocks/site/areas.html", "fields": [
      { "key": "suburbs", "selector": "p.suburbs", "kind": "inline", "repeat": false, "optional": false },
      { "key": "more", "selector": "p.areas-more", "kind": "inline", "repeat": false, "optional": true } ] },
    "package": { "label": "Package card", "families": ["site"], "addable": true, "snippet": "blocks/site/package.html", "fields": [
      { "key": "name", "selector": ".pkg-name", "kind": "text", "repeat": false, "optional": false },
      { "key": "tag", "selector": ".pkg-tag", "kind": "inline", "repeat": false, "optional": false },
      { "key": "was", "selector": ".pkg-price .was s", "kind": "inline", "repeat": false, "optional": true },
      { "key": "price", "selector": ".pkg-price .now", "kind": "inline", "repeat": false, "optional": false },
      { "key": "valueNote", "selector": ".pkg > p.value-note", "kind": "inline", "repeat": false, "optional": true },
      { "key": "above", "selector": ".pkg > p:not(.value-note):not(ul.list ~ p)", "kind": "inline", "repeat": true, "optional": false },
      { "key": "below", "selector": ".pkg > ul.list ~ p:not(.value-note)", "kind": "inline", "repeat": true, "optional": true },
      { "key": "callout", "selector": ".pkg-callout", "kind": "inline", "repeat": false, "optional": true },
      { "key": "items", "selector": ".pkg > ul.list > li", "kind": "inline", "repeat": true, "optional": false },
      { "key": "best", "selector": ".best", "kind": "inline", "repeat": false, "optional": true },
      { "key": "primary", "selector": "a.btn:not(.btn-ghost)", "kind": "link", "repeat": false, "optional": false },
      { "key": "secondary", "selector": "a.btn-ghost", "kind": "link", "repeat": false, "optional": true } ] },
    "notice": { "label": "Highlight box", "families": ["site"], "addable": true, "snippet": "blocks/site/notice.html", "fields": [
      { "key": "label", "selector": ".notice > .label", "kind": "text", "repeat": false, "optional": false },
      { "key": "text", "selector": ".notice > p", "kind": "inline", "repeat": false, "optional": false } ] },
    "box-list": { "label": "Boxed list", "families": ["site"], "addable": true, "snippet": "blocks/site/box-list.html", "fields": [
      { "key": "items", "selector": ".box li", "kind": "inline", "repeat": true, "optional": false } ] },
    "question": { "label": "Question", "families": ["site"], "addable": true, "snippet": "blocks/site/question.html", "fields": [
      { "key": "question", "selector": "summary", "kind": "inline", "repeat": false, "optional": false },
      { "key": "answer", "selector": "details > p", "kind": "inline", "repeat": false, "optional": false } ] },
    "xmas-card": { "label": "Christmas minis card", "families": ["site"], "addable": false, "locked": true, "hint": "This part has a form or live switching in it, so a developer edits it. You can move it.", "fields": [] },
    "signup": { "label": "Email sign-up form", "families": ["site"], "addable": false, "locked": true, "hint": "This part has a form or live switching in it, so a developer edits it. You can move it.", "fields": [] },
